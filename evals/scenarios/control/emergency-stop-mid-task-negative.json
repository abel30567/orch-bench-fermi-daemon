{
  "name": "emergency-stop-mid-task-negative",
  "description": "Negative control: the drain goes straight from the claim to the backup command, so the stop fires on that mac_shell; the stop turn then reruns the backup and completes the task done, so the stop assertions must fail.",
  "expectOutcome": "fail",
  "fixtures": {
    "bindings": [{"channel": "sl", "sender_id": "U0EVALOWNER", "note": "owner"}],
    "mac": [{"tool": "mac_shell", "match": "eval-backup\\.sh", "result": "backup: 40% (placeholder output)"}]
  },
  "inbound": {"channel": "sl", "sender": "U0EVALOWNER", "chat": "D0EVAL", "text": "Run the full backup now"},
  "session": [{"turn": "drain", "interruptAfterClaim": {"ms": 30000}}, {"turn": "stop"}, {"turn": "keepalive"}],
  "expect": [
    {"task.status": "failed"},
    {"argsMatch": {"tool": "task_complete", "args": {"status": "failed", "result": "/stopped by user/i"}}},
    {"argsMatch": {"tool": "channel_send", "args": {"chat_id": "D0EVAL", "text": "/🛑 Stopped/"}}},
    {"atMostOnce": "mac_shell"},
    {"exactlyOnce": "task_complete"},
    {"notCalled": "task_list"},
    {"outbox.count": {"min": 1, "max": 2, "chat_id": "D0EVAL"}}
  ],
  "fake": {
    "turns": [
      [
        {"tool": "task_claim", "args": {"limit": 1, "stale_minutes": 25}},
        {"tool": "mac_shell", "args": {"command": "~/bin/eval-backup.sh --full"}},
        {"tool": "channel_send", "args": {"channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Backup finished."}},
        {"tool": "task_complete", "args": {"id": "${task.id}", "status": "done", "result": "ran the backup"}}
      ],
      [
        {"tool": "mac_shell", "args": {"command": "~/bin/eval-backup.sh --full"}},
        {"tool": "channel_send", "args": {"channel": "${task.channel}", "chat_id": "${task.chat_id}", "text": "Backup finished."}},
        {"tool": "task_complete", "args": {"id": "${task.id}", "status": "done", "result": "ran the backup"}}
      ],
      [
        {"text": "OK"}
      ]
    ]
  }
}
